<?xml version="1.0" encoding="utf-8"?>
<!-- 백업·기기 이전에서 모두 뺀다. 접근 키 키셋은 Keystore에 묶여 다른 기기에서 풀 수 없다(AOS-007) -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
